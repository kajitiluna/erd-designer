{
  "name": "erd-designer",
  "displayName": "ERD Designer",
  "description": "Visually design database ER diagrams in VSCode — DDL import/export for 7 databases, Excel specification documents, and a built-in MCP server so AI assistants can edit the same diagram",
  "license": "Apache-2.0",
  "keywords": [
    "erd",
    "er-diagram",
    "entity-relationship-diagram",
    "database",
    "database-design",
    "schema-design",
    "sql",
    "ddl",
    "mcp",
    "model-context-protocol",
    "postgresql",
    "mysql",
    "bigquery",
    "snowflake",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kajitiluna/erd-designer"
  },
  "bugs": {
    "url": "https://github.com/kajitiluna/erd-designer/issues"
  },
  "icon": "images/icon.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "publisher": "kajitiluna",
  "version": "0.0.1",
  "main": "./out/extension/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "erdDesigner.erdEditor",
        "displayName": "ERD Designer",
        "selector": [
          {
            "filenamePattern": "*.erd"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "erdDesigner.ermImporter",
        "displayName": "ERD Designer (import .erm)",
        "selector": [
          {
            "filenamePattern": "*.erm"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "ERD Designer",
      "properties": {
        "erdDesigner.mcpServer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable MCP Server for ERD Designer functionality"
        },
        "erdDesigner.mcpServer.port": {
          "type": "number",
          "default": 53753,
          "description": "MCP Server port number",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    }
  },
  "homepage": "https://kajitiluna.github.io/erd-designer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist out *.vsix",
    "watch:extension": "concurrently \"tsc -p ./tsconfig.extension.json --watch --noEmit\" \"tsc-alias -p ./tsconfig.extension.json --watch\"",
    "build": "npm run clean && npm run build:webview && npm run check:extension && npm run bundle:extension",
    "build:webview": "tsc -b && vite build",
    "check:extension": "tsc -p ./tsconfig.extension.json --noEmit",
    "bundle:extension": "esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --tsconfig=tsconfig.extension.json --outfile=out/extension/extension.js --minify && echo '{\"type\":\"commonjs\"}' > out/package.json",
    "bundle:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=cjs --target=node22 --tsconfig=tsconfig.extension.json --outfile=out/cli/erd-cli.cjs --minify",
    "postbuild": "cp dist/index.html dist/404.html",
    "package": "npm run package:extension",
    "package:extension": "npx vsce package --readme-path README_extension.md",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "testrun": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.1.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@react-oauth/google": "^0.12.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "node-sql-parser": "^5.3.10",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/express": "^5.0.5",
    "@types/node": "^26.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.105.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-testing-library": "^7.1.1",
    "globals": "^17.4.0",
    "jsdom": "^27.0.0",
    "ovsx": "^1.1.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "volta": {
    "node": "26.8.1"
  },
  "overrides": {
    "inflight": "npm:@derhuerst/inflight@latest",
    "glob": "^10.3.10",
    "fast-csv": "^5.0.0",
    "unzipper": "^0.12.0",
    "shell-quote": ">=1.10.0",
    "hono": ">=4.12.25",
    "undici": ">=7.29.0 <8.0.0",
    "ws": ">=8.21.0",
    "form-data": ">=4.0.6",
    "js-yaml": ">=4.3.1 <5.0.0",
    "markdown-it": ">=14.2.0",
    "@hono/node-server": ">=2.0.5",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "@swc/core@1.15.41": true,
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "keytar@7.9.0": true
  }
}
