{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "skipLibCheck": true,
    "outDir": "./out",
    "rootDir": "./src",

    "baseUrl": "src/",
    "paths": {
      "~/*": ["*"]
    },

    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/extension/**/*",
    "src/components/**/*",
    "src/context/**/*",
    "src/features/MainView.tsx",
    "src/features/canvas/**/*",
    "src/features/editor/**/*",
    "src/features/start_up/InitializeDatabaseDialog.tsx",
    "src/features/spec/ExcelFormatSpecification.ts",
    "src/features/storage/**/*",
    "src/models/**/*",
    "src/css-modules.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}